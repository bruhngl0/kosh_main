# ── Local development (Docker) ───────────────────────────────────────────────
# Both point at the same instance locally; on Neon they differ (see below).
DATABASE_URL="postgresql://kosh:kosh@localhost:55432/kosh?schema=public"
DIRECT_URL="postgresql://kosh:kosh@localhost:55432/kosh?schema=public"
APP_URL="http://localhost:3000"

# ── Hosted (Vercel + Neon) ───────────────────────────────────────────────────
# DATABASE_URL must be the POOLED endpoint (contains "-pooler"): serverless
# invocations would otherwise exhaust Neon's connection limit.
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/kosh?sslmode=require"
#
# DIRECT_URL must be the UNPOOLED endpoint. Migrations take advisory locks that
# a transaction pooler cannot hold, so `prisma migrate deploy` needs a direct
# connection.
#   DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/kosh?sslmode=require"

# Seeds a preview database on deploy. Never enable in production.
# SEED_ON_DEPLOY="false"

# Overrides the seeded operations user the MVP runs mutations as (§8.1).
# SYSTEM_ACTOR_EMAIL="admin@kosh.local"

# Shared secret the onboarding app uses to create subscribers (BR-23). At least
# 32 characters; generate with `openssl rand -hex 32`. Same value as
# KOSH_OPS_SYNC_TOKEN in koshOnboarding.
# ONBOARDING_SYNC_TOKEN=""

# Kitchen capacity in seats (BR-25). Defaults to 40.
# SUBSCRIBER_CAPACITY="40"
